{
  "name": "Ansible-SecAgent",
  "team_name": "ansible-secagent-team",
  "org": "CCoupel",
  "project": "Ansible-SecAgent",
  "description": "Système d'exécution de playbooks Ansible sur hôtes distants sans connexion SSH entrante (modèle connexions inversées, agents clients)",
  "version": "0.1.0",
  "initialized_at": "2026-05-22T00:00:00Z",
  "initialized_from": "analysis",
  "stack": {
    "backend": { "language": "go", "framework": null },
    "frontend": null,
    "mobile": null,
    "firmware": null,
    "plugin": { "platform": "Ansible (connection + inventory)" },
    "database": { "primary": "sqlite", "orm": "modernc.org/sqlite" }
  },
  "infrastructure": {
    "cicd": null,
    "environments": [
      {
        "name": "QUALIF",
        "order": 1,
        "publish": { "mode": "promote", "target": "build/qualif_v{X.Y.Z}/" },
        "deploy": { "mechanism": "docker-compose", "target": "docker-compose.qualif.yml" }
      },
      {
        "name": "PROD",
        "order": 2,
        "publish": { "mode": "rebuild-ci", "trigger": "git-tag", "pipeline": ".github/workflows/release.yml" },
        "deploy": { "mechanism": "docker-compose", "target": "docker-compose.prod.yml" }
      }
    ]
  },
  "testing": {
    "backend": ["go-test"],
    "frontend": [],
    "e2e": ["pytest"]
  },
  "security": {
    "concerns": ["auth", "api-public", "multi-tenant"]
  },
  "commands": {
    "build": "cd GO && go build ./...",
    "test": "cd GO && JWT_SECRET_KEY=test ADMIN_TOKEN=test go test ./... -v",
    "lint": "cd GO && golangci-lint run",
    "audit": "cd GO && govulncheck ./...",
    "typecheck": ""
  },
  "agents": {
    "idle_ttl_minutes": 15,
    "idle_warning_interval_minutes": 5
  }
}
