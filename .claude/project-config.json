{
  "name": "Ansible-SecAgent",
  "team_name": "ansible-secagent-team",
  "org": "CCoupel",
  "project": "Ansible-SecAgent",
  "description": "Système d'exécution de playbooks Ansible sur hôtes distants sans connexion SSH entrante (modèle connexions inversées, agents clients)",
  "version": "3.0.3",
  "initialized_at": "2026-05-22T00:00:00Z",
  "initialized_from": "analysis",
  "stack": {
    "backend": {
      "language": "go",
      "framework": null
    },
    "frontend": null,
    "mobile": null,
    "firmware": null,
    "plugin": {
      "platform": "Ansible (connection + inventory)"
    },
    "database": {
      "primary": "file-state",
      "orm": null,
      "note": "fichier d'état relay.state (HMAC, STATE_DIR) + verrou relay.lock ; pas de SQLite, pas de NATS, CGO_ENABLED=0"
    }
  },
  "infrastructure": {
    "cicd": "github-actions",
    "environments": [
      {
        "name": "QUALIF",
        "order": 1,
        "publish": {
          "mode": "promote",
          "trigger": "workflow_dispatch",
          "pipeline": ".github/workflows/candidate-images.yml",
          "target": "ghcr.io/ccoupel/secagent-{server,minion}:sha-<commit>@sha256:<digest> (linux/amd64)"
        },
        "deploy": {
          "mechanism": "docker-compose",
          "target": "DEPLOYMENT/qualif/docker-compose.server.yml",
          "chain": "DEPLOYMENT/qualif/docker-compose.chain.yml",
          "script": "DEPLOYMENT/qualif/chain-test.sh",
          "host": "192.168.1.218"
        }
      },
      {
        "name": "PROD",
        "order": 2,
        "publish": {
          "mode": "rebuild-ci",
          "trigger": "git-tag",
          "pipeline": ".github/workflows/release.yml"
        },
        "deploy": {
          "mechanism": "docker-compose",
          "target": "DEPLOYMENT/prod/docker-compose.server.yml"
        }
      }
    ]
  },
  "testing": {
    "backend": [
      "go-test"
    ],
    "frontend": [],
    "e2e": [
      "pytest"
    ],
    "components": {},
    "regression_at_qa": "gated",
    "full_regression_at": "qualif",
    "coverage_min": 70,
    "lot_max_tests": 50
  },
  "security": {
    "concerns": [
      "auth",
      "api-public",
      "multi-tenant"
    ]
  },
  "commands": {
    "build": "cd GO && go build ./...",
    "test": "cd GO && JWT_SECRET_KEY=test ADMIN_TOKEN=test go test ./... -v",
    "lint": "cd GO && golangci-lint run",
    "audit": "cd GO && govulncheck ./...",
    "typecheck": ""
  },
  "agents": {
    "idle_ttl_minutes": 15,
    "idle_warning_interval_minutes": 5
  },
  "template_version": {
    "tag": "v3.13.1",
    "commit": "b1a3b8e41b4dd3a551917e1ce6c99e1bd6957655"
  }
}
