# .env.proxy — Variables d'environnement pour docker-compose.proxy.yml
#
# Usage :
#   cp .env.proxy .env
#   # Éditer .env pour renseigner les vraies valeurs
#   DOCKER_HOST=tcp://192.168.1.218:2375 docker compose -f docker-compose.proxy.yml up --build -d

# ─────────────────────────────────────────────────────────────────────────────
# Secrets obligatoires — CHANGER avant tout déploiement
# ─────────────────────────────────────────────────────────────────────────────

# Clef HMAC-SHA256 pour la signature des JWT (min 32 caractères)
JWT_SECRET_KEY=changeme-jwt-secret-at-least-32-chars

# Token Bearer pour les endpoints /api/admin/* (tous les relays partagent le même)
ADMIN_TOKEN=changeme-admin-token

# Token d'enrollment pour les agents secagent-minion
# Générer via : curl -X POST http://localhost:7780/api/admin/enrollment-token \
#               -H "Authorization: Bearer $ADMIN_TOKEN"
RELAY_ENROLLMENT_TOKEN=changeme-enrollment-token

# Optionnel : surcharger les URLs internes si les relays DMZ sont externes
# (laisser vide pour utiliser les valeurs par défaut du compose)
# RELAY_DMZ1_URL=http://relay-dmz1:7770
# RELAY_DMZ2_URL=http://relay-dmz2:7770

# ─────────────────────────────────────────────────────────────────────────────
# Ports exposés sur l'hôte (référence)
# ─────────────────────────────────────────────────────────────────────────────
# relay-proxy API   : 192.168.1.218:7780
# relay-proxy Admin : 192.168.1.218:7781
# relay-proxy WS    : 192.168.1.218:7782
# relay-dmz1 API    : 192.168.1.218:7783  (smoke test uniquement)
# relay-dmz2 API    : 192.168.1.218:7784  (smoke test uniquement)
