{
  "hooks": [
    {
      "event": "host.up",
      "actions": [
        { "type": "file", "path": "/run/secagent/events.log", "append": "{{timestamp}} UP   {{hostname}}\n" }
      ]
    },
    {
      "event": "host.down",
      "actions": [
        { "type": "file", "path": "/run/secagent/events.log", "append": "{{timestamp}} DOWN {{hostname}}\n" }
      ]
    }
  ]
}
