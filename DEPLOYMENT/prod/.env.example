# Variables d'interpolation du Compose — NON secretes. Copier en `.env` (hors depot) sur chaque hote.
SECAGENT_VERSION=v3.0.5
# Point de montage (sur l'hote) du partage qui porte STATE_DIR. Meme contenu sur tous les hotes.
STATE_HOST_DIR=/mnt/secagent-state
# Repertoire contenant tls.crt (chaine complete) et tls.key.
TLS_CERT_DIR=/etc/secagent/tls
# Adresse d'hote sur laquelle publier l'admin 7771 (boucle locale ou reseau d'administration, JAMAIS 0.0.0.0).
ADMIN_PUBLISH_ADDR=127.0.0.1
# Ports d'HOTE publies (defauts du Compose : 7770 / 7772 / 7771 ; ports du conteneur inchanges). Hote partage avec la
# QUALIF (192.168.1.218, ou secagent-qualif tient 7770-7772 et 8770-8772) : 17770 / 17772 / 17771 ci-dessous. Les clients
# visent ces ports : minions RELAY_SERVER_URL=https://<hote>:17770 et RELAY_WS_URL=wss://<hote>:17772/ws/agent, plugin
# (adresse du relay en :17770), relays enfants REPEATER_UPSTREAM_URL=wss://<hote>:17772. Hote dedie : supprimer ces lignes.
API_PUBLISH_PORT=17770
WS_PUBLISH_PORT=17772
ADMIN_PUBLISH_PORT=17771
LOG_LEVEL=INFO
# Repertoire des fichiers de secrets (jwt_secret_key, admin_token, rsa_master_key[, repeater_upstream_token]) : proprietaire
# UID 10001, mode 0400/0600 (Compose ignore uid/gid/mode). Defaut ./secrets. Voir prod.env.example et preflight-secrets.sh.
# Hors depot.
# SECRETS_DIR=./secrets
# Relay enfant uniquement (docker-compose.child.yml) :
# REPEATER_ID=
# wss:// obligatoire (le serveur refuse https:// et ws://) ; port WebSocket D'HOTE du parent (WS_PUBLISH_PORT, 7772 par defaut ;
# 17772 pour la PROD de 192.168.1.218), pas l'API ;
# une adresse par instance du parent (16 au plus), sans identifiants dans l'adresse.
# REPEATER_UPSTREAM_URL=wss://relay-a.example:7772,wss://relay-b.example:7772
# Ancre de confiance (v3.0.4) : relay_id de la racine (affiche par `keys link-pubkey` sur la racine) et chemin HOTE
# de sa cle publique PEM (non secrete, chmod 0644 ; jamais inscriptible par le groupe ni les autres).
# REPEATER_ROOT_ID=
# ROOT_LINK_KEY_FILE=/etc/secagent/root-link.pub
# Memoire du conteneur et GOMEMLIMIT (~80 %, a modifier ENSEMBLE ; defauts : 2g / 1638MiB, pour > 3000 hotes).
# Budget stdout par defaut 1 Gio (204 taches simultanees par relay). forks Ansible 300-400 : MAX_STDOUT_BUFFER_TOTAL=2147483648
# (409 taches, voir docker-compose.server.yml) EXIGE au moins 4g / 3276MiB ci-dessous.
SECAGENT_MEM_LIMIT=2g
GOMEMLIMIT=1638MiB
