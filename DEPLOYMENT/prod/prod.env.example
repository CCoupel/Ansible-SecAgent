# SECRETS du serveur — copier en `prod.env` (hors depot, mode 0600), jamais commite.
# JWT_SECRET_KEY, ADMIN_TOKEN et RSA_MASTER_KEY sont IDENTIQUES sur tous les noeuds candidats d'un relay.
JWT_SECRET_KEY=
ADMIN_TOKEN=
# Sauvegardee HORS hote ET hors du partage (voir README) : sans elle les champs `enc:` de l'etat sont illisibles.
RSA_MASTER_KEY=
# Relay enfant uniquement :
# REPEATER_UPSTREAM_TOKEN=
# REPEATER_CA_FILE=/certs/ca.pem
